#!/usr/bin/env python3
"""Validate _data/talks.json before it reaches the site.

JSON is unforgiving and Jekyll is quiet about it: a single trailing comma makes
the whole data file vanish and the site builds happily with an empty schedule.
This turns that silent failure into a loud one.

Standard library only -- no install step, runs anywhere Python 3 does.

Usage:  bin/check-talks [path]
Exit:   0 = clean (warnings allowed), 1 = errors found
"""

import datetime
import json
import pathlib
import re
import sys
from pathlib import Path

VALID_STATUS = {"tba", "confirmed", "cancelled"}

# This repo is public, so anything in talks.json is one push from the open web
# whether or not the page renders it. Speaker contact addresses have no reason
# to be here -- the site never uses them.
EMAIL_RE = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}")
KNOWN_KEYS = {
    "date", "time", "location", "status", "tentative", "title", "abstract",
    "speakers", "slides", "videos", "links", "tags",
}
# A speaker may be tentative on their own: a slot can have a firm date while one
# invitee has not yet agreed to it (a partly-confirmed panel).
SPEAKER_KEYS = {"name", "tentative", "role", "org", "bio", "materials", "links"}
VALID_FORMATS = {"presentation", "panel", "interview"}
LINK_LISTS = ("slides", "videos", "links")

errors = []
warnings = []


def err(where, msg):
    errors.append(f"{where}: {msg}")


def warn(where, msg):
    warnings.append(f"{where}: {msg}")


def check_link_list(where, items, field):
    if not isinstance(items, list):
        err(where, f'"{field}" must be a list, got {type(items).__name__}')
        return
    for i, item in enumerate(items):
        at = f"{where} {field}[{i}]"
        if not isinstance(item, dict):
            err(at, f"must be an object like " '{"label": "...", "url": "..."}')
            continue
        if not str(item.get("url", "")).strip():
            err(at, 'has no "url" -- it would render as a dead link')
        if not str(item.get("label", "")).strip():
            warn(at, 'has no "label"; a generic one will be shown')


def check_release(where, rel):
    """Validate the signed-video-release record on one speaker.

    Shape:  {"signed": false}                       -- not received
            {"signed": true, "path": "_speakers/..."}  -- received

    The file itself is deliberately absent from git (it carries the speaker's
    signature and this repo is public), so a missing file is a WARNING, never an
    error. CI checks out a clean tree where these never exist, and blocking the
    deploy over that would be wrong.
    """
    if not isinstance(rel, dict):
        err(where, '"release" must be an object like {"signed": false}')
        return
    for key in rel:
        if key not in {"signed", "path"}:
            warn(f"{where} release", f'unknown field "{key}" -- it will be ignored (typo?)')

    signed = rel.get("signed")
    if not isinstance(signed, bool):
        err(f"{where} release", f'"signed" must be true or false, got {signed!r}')
        return

    path = rel.get("path")
    if signed:
        if not isinstance(path, str) or not path.strip():
            err(f"{where} release", '"signed" is true but there is no "path" to the form')
            return
        if path.startswith("/") or ".." in Path(path).parts:
            err(f"{where} release", f'path "{path}" must be relative to the repo root '
                                    "and must not climb out of it")
        elif not path.startswith("_speakers/"):
            warn(f"{where} release", f'path "{path}" is outside _speakers/; releases belong '
                                     "there so Jekyll never serves them")
        elif not Path(path).exists():
            warn(f"{where} release",
                 f"{path} is not in this working copy -- expected on a fresh clone or in CI, "
                 "since signed releases are gitignored")
    elif path:
        warn(f"{where} release", '"signed" is false but a "path" is set; '
                                 "set signed to true or drop the path")


def check_materials(where, m, talk):
    """Validate one speaker's intake checklist.

    The nine things a confirmed speaker owes us (format, display name, headshot,
    bio, title, abstract, signed release, parking, travel) are tracked here so
    "what is still missing" is answerable per person rather than by rereading
    the mail. Title and abstract are only owed when the format is a
    presentation, and they live on the talk, not the speaker.

    Inferred values are allowed but must be marked unconfirmed, so a guess about
    someone's travel needs never quietly hardens into a fact.
    """
    if not isinstance(m, dict):
        err(where, '"materials" must be an object')
        return
    for key in m:
        if key not in {"format", "display_name", "headshot", "release", "parking", "travel"}:
            warn(f"{where} materials", f'unknown field "{key}" -- it will be ignored (typo?)')

    fmt = m.get("format")
    if fmt is not None and fmt not in VALID_FORMATS:
        err(f"{where} materials", f'format "{fmt}" is not one of: {", ".join(sorted(VALID_FORMATS))}')

    hs = m.get("headshot")
    if hs is not None:
        if not isinstance(hs, dict):
            err(f"{where} materials", '"headshot" must be an object')
        else:
            for k in hs:
                if k not in {"have", "proposed_url", "source", "verified", "approved", "path"}:
                    warn(f"{where} materials headshot", f'unknown field "{k}"')
            if str(hs.get("proposed_url", "")).strip() and not str(hs.get("source", "")).strip():
                err(f"{where} materials headshot",
                    "a proposed image has no \"source\" -- record where it came from; an image "
                    "of the wrong person is the failure mode here")
            if hs.get("have") and not str(hs.get("path", "")).strip():
                err(f"{where} materials headshot", '"have" is true but there is no "path"')
            if hs.get("approved") is False:
                warn(f"{where} materials headshot",
                     "the speaker declined the proposed image -- ask them for one")
            if str(hs.get("proposed_url", "")).strip() and hs.get("approved") is None:
                warn(f"{where} materials headshot",
                     "an image was proposed but the speaker has not approved it yet")

    if "release" in m:
        check_release(f"{where} materials", m["release"])

    if m.get("parking") not in (None, True, False):
        err(f"{where} materials", f'"parking" must be true, false, or null, got {m["parking"]!r}')

    tr = m.get("travel")
    if tr is not None:
        if not isinstance(tr, dict):
            err(f"{where} materials", '"travel" must be an object')
        elif tr.get("local") not in (None, True, False):
            err(f"{where} materials travel", f'"local" must be true, false, or null, '
                                             f'got {tr["local"]!r}')
        elif tr.get("local") is not None and not tr.get("confirmed"):
            warn(f"{where} materials travel",
                 "local/remote is a guess the speaker has not confirmed -- "
                 "check it before booking anything")


def missing_items(speaker, talk):
    """The intake items this speaker still owes, by the numbering in the ask."""
    m = speaker.get("materials") or {}
    out = []
    if not m.get("format"):
        out.append("format")
    if not str(m.get("display_name", "")).strip():
        out.append("display name")
    if not (m.get("headshot") or {}).get("have"):
        out.append("headshot")
    if not str(speaker.get("bio", "")).strip():
        out.append("bio")
    if m.get("format") == "presentation":
        if not str(talk.get("title", "")).strip():
            out.append("talk title")
        if not str(talk.get("abstract", "")).strip():
            out.append("abstract")
    if not (m.get("release") or {}).get("signed"):
        out.append("signed release")
    if m.get("parking") is None:
        out.append("parking")
    if (m.get("travel") or {}).get("local") is None:
        out.append("travel")
    return out


def check_speakers(where, speakers, talk_tentative, talk):
    if not isinstance(speakers, list):
        err(where, f'"speakers" must be a list, got {type(speakers).__name__}')
        return
    for i, s in enumerate(speakers):
        at = f"{where} speakers[{i}]"
        if not isinstance(s, dict):
            err(at, "must be an object")
            continue
        if not str(s.get("name", "")).strip():
            err(at, 'has no "name"')
        if "tentative" in s and not isinstance(s["tentative"], bool):
            err(at, f'"tentative" must be true or false, got {s["tentative"]!r}')
        # A tentative slot already hides everyone in it, so a per-speaker flag
        # there is dead weight -- and worse, it implies the others are settled.
        if talk_tentative and s.get("tentative") is True:
            warn(at, 'is marked tentative inside an already-tentative talk; '
                     "the talk-level flag hides the whole slot, so this has no effect")
        if "materials" in s:
            check_materials(at, s["materials"], talk)

        links = s.get("links")
        if links is not None:
            check_link_list(at, links, "links")
        for key in s:
            if key not in SPEAKER_KEYS and not key.startswith("_"):
                warn(at, f'unknown field "{key}" -- it will be ignored (typo?)')


def main():
    path = Path(sys.argv[1] if len(sys.argv) > 1 else "_data/talks.json")

    if not path.exists():
        print(f"ERROR: {path} not found", file=sys.stderr)
        return 1

    raw = path.read_text(encoding="utf-8")
    try:
        doc = json.loads(raw)
    except json.JSONDecodeError as e:
        line = raw.splitlines()[e.lineno - 1] if 0 < e.lineno <= len(raw.splitlines()) else ""
        print(f"ERROR: {path} is not valid JSON", file=sys.stderr)
        print(f"  line {e.lineno}, column {e.colno}: {e.msg}", file=sys.stderr)
        if line:
            print(f"  {line.rstrip()}", file=sys.stderr)
            print(f"  {' ' * (e.colno - 1)}^", file=sys.stderr)
        print("  (a trailing comma after the last item is the usual cause)", file=sys.stderr)
        return 1

    if not isinstance(doc, dict) or not isinstance(doc.get("talks"), list):
        print('ERROR: expected a top-level object with a "talks" list', file=sys.stderr)
        return 1

    talks = doc["talks"]
    seen_dates = {}

    # Scan the raw text: catches an address in any field, including ones this
    # validator does not otherwise know about.
    for lineno, line in enumerate(raw.splitlines(), 1):
        for addr in EMAIL_RE.findall(line):
            if addr.startswith("mailto:"):
                continue
            err(f"line {lineno}",
                f"contains an email address ({addr}) -- this repo is public; "
                "speaker contact details do not belong in talks.json")

    # tracking.json is tracked in git too, and its free-text notes are written by
    # hand during outreach checks -- which is exactly how two personal addresses
    # (a speaker's work address and a lead's private Gmail) ended up staged for a
    # public push on 2026-09-18 and were caught at the last moment. The talks.json
    # scan above would never have seen them, because it only reads talks.json.
    # Addresses live only in contacts.local.json, which is gitignored; reference a
    # contact_key here instead. Note this scanner does not read itself -- do not
    # paste a real address into this file as an example.
    trk = pathlib.Path("_outreach/tracking.json")
    if trk.is_file():
        for lineno, line in enumerate(trk.read_text().splitlines(), 1):
            for addr in EMAIL_RE.findall(line):
                if addr.startswith("mailto:"):
                    continue
                err(f"_outreach/tracking.json line {lineno}",
                    f"contains an email address ({addr}) -- this file is tracked and "
                    "this repo is public; put addresses in contacts.local.json and "
                    "refer to the contact_key here")

    for i, t in enumerate(talks):
        where = f"talks[{i}]"
        if not isinstance(t, dict):
            err(where, "must be an object")
            continue

        # date
        raw_date = t.get("date")
        if not raw_date:
            err(where, 'missing required field "date"')
        else:
            try:
                d = datetime.date.fromisoformat(str(raw_date))
            except ValueError:
                err(where, f'date "{raw_date}" is not a valid YYYY-MM-DD date')
            else:
                where = f'talks[{i}] ({raw_date})'
                if d.weekday() != 0:
                    warn(where, f"falls on a {d.strftime('%A')}, not a Monday")
                if raw_date in seen_dates:
                    err(where, f"duplicate date, already used by talks[{seen_dates[raw_date]}]")
                else:
                    seen_dates[raw_date] = i

        # status
        status = t.get("status")
        if status is None:
            err(where, 'missing required field "status"')
        elif status not in VALID_STATUS:
            err(where, f'status "{status}" is not one of: {", ".join(sorted(VALID_STATUS))}')

        # A confirmed slot with neither a speaker nor a title is almost certainly
        # a mistake; a panel with a title but no named speakers is fine.
        if status == "confirmed" and not t.get("speakers") and not str(t.get("title", "")).strip():
            warn(where, 'status is "confirmed" but there is no speaker and no title')

        if "tentative" in t and not isinstance(t["tentative"], bool):
            err(where, f'"tentative" must be true or false, got {t["tentative"]!r}')

        if t.get("speakers") is not None:
            check_speakers(where, t["speakers"], t.get("tentative") is True, t)

        for field in LINK_LISTS:
            if t.get(field) is not None:
                check_link_list(where, t[field], field)

        if t.get("tags") is not None and not isinstance(t["tags"], list):
            err(where, '"tags" must be a list')

        # typo catcher: "speaker" instead of "speakers", etc.
        for key in t:
            if key not in KNOWN_KEYS and not key.startswith("_"):
                warn(where, f'unknown field "{key}" -- it will be ignored (typo?)')

    for w in warnings:
        print(f"warning: {w}")
    for e in errors:
        print(f"ERROR: {e}", file=sys.stderr)

    n = len(talks)
    if errors:
        print(f"\n{len(errors)} error(s) in {n} talk(s) -- not safe to publish", file=sys.stderr)
        return 1

    tba = sum(1 for t in talks if isinstance(t, dict) and t.get("status") == "tba")
    tent = sum(1 for t in talks if isinstance(t, dict) and t.get("tentative") is True)
    people = [s for t in talks if isinstance(t, dict)
              for s in (t.get("speakers") or []) if isinstance(s, dict)]
    complete = sum(1 for t in talks if isinstance(t, dict)
                   for s in (t.get("speakers") or [])
                   if isinstance(s, dict) and not missing_items(s, t))
    rel_have = sum(1 for s in people
                   if ((s.get("materials") or {}).get("release") or {}).get("signed") is True)
    rel_total = len(people)
    tent_sp = sum(
        1
        for t in talks
        if isinstance(t, dict) and t.get("tentative") is not True
        for s in (t.get("speakers") or [])
        if isinstance(s, dict) and s.get("tentative") is True
    )
    # Speakers held back inside otherwise-public slots are counted separately:
    # they are the ones a reader of the live site would notice missing.
    print(f"\nOK: {n} talk(s), {n - tba} filled in, {tba} still TBA, {tent} tentative"
          f"{f', {tent_sp} tentative speaker(s) in published slots' if tent_sp else ''}"
          f"{f', {rel_have}/{rel_total} signed release(s)' if rel_total else ''}"
          f"{f', {complete}/{rel_total} intake complete' if rel_total else ''}"
          f"{f' -- {len(warnings)} warning(s)' if warnings else ''}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
